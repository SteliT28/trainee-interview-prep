{
  "name": "interview",
  "main": "worker.js",
  "compatibility_date": "2026-08-22",

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nldc_access",
      "database_id": ""
    }
  ],

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
