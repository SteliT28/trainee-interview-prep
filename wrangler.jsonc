
{
  "name": "nldc-careers-hub",
  "main": "worker.js",
  "compatibility_date": "2026-08-22",

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nldc_access",
      "database_id": "ea99a67f-4a43-4806-bf59-8ba7c22eedb1"
    }
  ],

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
